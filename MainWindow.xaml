<Window x:Class="MeshinaStandalone.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="线外啮合 · MES" Width="560" Height="760" MinWidth="500" MinHeight="680" Background="#F3F5F8" Topmost="True" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6"/></Style>
 </Window.Resources>
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="130"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10">
   <TextBlock Text="线外啮合" FontSize="24" FontWeight="Bold" Foreground="#163B5C"/>
   <TextBlock x:Name="ConfigText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#526477" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,10">
   <ComboBox x:Name="StationBox" Padding="6" SelectionChanged="StationChanged"/>
   <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
    <Button x:Name="StartButton" Content="启动工位" Click="StartClick"/>
    <Button x:Name="StopButton" Content="停止工位" Click="StopClick" IsEnabled="False"/>
    <Button x:Name="SettingsButton" Content="配置" Click="SettingsClick"/>
   </StackPanel>
  </StackPanel>
  <StackPanel Grid.Row="2" Margin="0,0,0,10">
   <DockPanel>
    <Button DockPanel.Dock="Right" x:Name="ScanButton" Content="扫码进站" Click="ScanClick" Margin="8,0,0,0" IsEnabled="False"/>
    <TextBox x:Name="SnBox" FontSize="18" KeyDown="SnKeyDown" IsEnabled="False" ToolTip="产品SN，回车提交"/>
   </DockPanel>
   <TextBlock x:Name="JobText" Text="SN：—" FontSize="16" Margin="0,8,0,0" TextWrapping="Wrap"/>
   <TextBlock x:Name="ScanTimeText" Text="扫码时间：—" Margin="0,4,0,0" Foreground="#526477"/>
  </StackPanel>
  <UniformGrid Grid.Row="3" Columns="2" Margin="0,0,0,10">
   <Border Background="White" Padding="12" Margin="0,0,5,0" CornerRadius="5">
    <StackPanel><TextBlock Text="进站" Foreground="#526477"/><TextBlock x:Name="FeedingResultLabel" Text="待扫码" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
   </Border>
   <Border Background="White" Padding="12" Margin="5,0,0,0" CornerRadius="5">
    <StackPanel><TextBlock Text="出站" Foreground="#526477"/><TextBlock x:Name="CheckoutResultLabel" Text="未开始" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
   </Border>
  </UniformGrid>
  <StackPanel Grid.Row="4" Margin="0,0,0,10">
   <TextBlock x:Name="StatusText" Text="请核对工位配置后启动" FontSize="14" TextWrapping="Wrap" MaxHeight="62" TextTrimming="CharacterEllipsis"/>
   <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
    <Button x:Name="RetryButton" Content="重试原任务" Click="RetryClick" IsEnabled="False"/>
    <Button x:Name="AbortButton" Content="终止本件" Click="AbortClick" IsEnabled="False"/>
   </StackPanel>
  </StackPanel>
  <DataGrid Grid.Row="5" x:Name="ValuesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="28" Margin="0,0,0,10">
   <DataGrid.Columns>
    <DataGridTextColumn Header="字段" Binding="{Binding Field}" Width="55"/>
    <DataGridTextColumn Header="MES项目" Binding="{Binding Item}" Width="*"/>
    <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="85"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBox Grid.Row="6" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#172C3D" Foreground="#E0E9F0"/>
 </Grid>
</Window>
