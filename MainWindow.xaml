<Window x:Class="MeshinaStandalone.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="线外啮合 · MES" Width="600" Height="800" MinWidth="560" MinHeight="800" Background="#F3F5F8" Topmost="True" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10" Grid.ColumnSpan="2">
            <TextBlock Text="线外啮合" FontSize="24" FontWeight="Bold" Foreground="#163B5C"/>
            <TextBlock x:Name="ConfigText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#526477" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <StackPanel Margin="0,40,0,10" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <ComboBox x:Name="StationBox" Padding="6" SelectionChanged="StationChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="StartButton" Content="启动工位" Click="StartClick"/>
                <Button x:Name="StopButton" Content="停止工位" Click="StopClick" IsEnabled="False"/>
                <Button x:Name="SettingsButton" Content="配置" Click="SettingsClick"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,10" Grid.ColumnSpan="2">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="ScanButton" Content="扫码进站" Click="ScanClick" Margin="8,0,0,0" IsEnabled="False"/>
                <TextBox x:Name="SnBox" FontSize="18" KeyDown="SnKeyDown" IsEnabled="False" ToolTip="产品SN，回车提交"/>
            </DockPanel>
            <TextBlock x:Name="QueueText" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ItemsControl Grid.Row="2" x:Name="TaskCards" Margin="0,70,0,0" Grid.ColumnSpan="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" Padding="8" Margin="0,0,6,0" CornerRadius="5" BorderBrush="#DCE3EA" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Foreground="#526477" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SN}" FontSize="17" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ScanTime}" TextWrapping="Wrap" FontSize="12" Foreground="#526477" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Stage}" Foreground="#163B5C" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <UniformGrid Columns="2" Margin="0,12,0,8">
                                <StackPanel>
                                    <TextBlock Text="进站" Foreground="#526477"/>
                                    <TextBlock Text="{Binding Feeding}" Foreground="{Binding FeedingColor}" ToolTip="{Binding FeedingMessage}" FontSize="23" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="出站" Foreground="#526477"/>
                                    <TextBlock Text="{Binding Checkout}" Foreground="{Binding CheckoutColor}" ToolTip="{Binding CheckoutMessage}" FontSize="23" FontWeight="Bold"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding Mdb}" ToolTip="{Binding MdbPath}" TextTrimming="CharacterEllipsis" Foreground="#526477" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding Values}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="25" Height="107">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="字段" Binding="{Binding Field}" Width="50"/>
                                    <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="*" MinWidth="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Row="3" Margin="0,10,0,10" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <TextBlock x:Name="StatusText" Text="请核对工位配置后启动" FontSize="14" TextWrapping="Wrap" MaxHeight="62" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="RetryButton" Content="重试原任务" Click="RetryClick" IsEnabled="False"/>
                <Button x:Name="AbortButton" Content="终止全部任务" Click="AbortClick" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
        <TextBox Grid.Row="4" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#172C3D" Foreground="#E0E9F0" Grid.ColumnSpan="2" Margin="0,67,0,0" Grid.RowSpan="2"/>
    </Grid>
</Window>
